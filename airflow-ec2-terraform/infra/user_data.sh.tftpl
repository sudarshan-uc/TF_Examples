#!/bin/bash
# First boot only: installs Podman and mounts EFS at /opt/airflow.
# Airflow itself is installed and updated by ../airflow-podman over SSH, so
# this script carries no secrets and no Airflow settings, and changing Airflow
# never replaces the instance. Log: /var/log/airflow-setup.log
set -euxo pipefail
exec > >(tee -a /var/log/airflow-setup.log) 2>&1

dnf install -y podman amazon-efs-utils rsync

mkdir -p /opt/airflow
MOUNT_OPTS="_netdev,noresvport,tls"
# When SELinux is on, label EFS so containers can use it.
if command -v selinuxenabled >/dev/null 2>&1 && selinuxenabled; then
  MOUNT_OPTS="$MOUNT_OPTS,context=system_u:object_r:container_file_t:s0"
fi
grep -q " /opt/airflow " /etc/fstab || echo "${efs_id}:/ /opt/airflow efs $MOUNT_OPTS 0 0" >> /etc/fstab

# EFS DNS can take a minute to become available after creation.
for _ in $(seq 1 30); do
  mountpoint -q /opt/airflow && break
  mount /opt/airflow || sleep 10
done
mountpoint -q /opt/airflow

podman --version
echo "Host ready for airflow-podman"
