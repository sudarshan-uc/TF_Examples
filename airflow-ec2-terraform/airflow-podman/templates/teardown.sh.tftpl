#!/usr/bin/env bash
# Rendered by Terraform (airflow-podman). Runs on destroy, or when a host is
# removed from var.hosts. Removes only what this module created.
set -uo pipefail

UNIT_DIR=/etc/containers/systemd
log() { printf '[airflow-podman teardown] %s\n' "$*"; }

for f in "$UNIT_DIR"/airflow-*.container; do
  [ -e "$f" ] || continue
  grep -q 'Managed by Terraform (airflow-podman)' "$f" || continue
  n=$(basename "$f" .container)
  log "stopping $n"
  systemctl stop "$n.service" 2> /dev/null || true
  rm -f "$f"
done
systemctl daemon-reload || true
systemctl reset-failed 'airflow-*' 2> /dev/null || true

podman ps -a --filter label=io.astronomer.managed-by=terraform --format '{{.Names}}' | while read -r c; do
  podman rm -f "$c" > /dev/null 2>&1 || true
done
podman secret rm airflow-redis-conf > /dev/null 2>&1 || true
podman images --format '{{.Repository}}:{{.Tag}}' --filter reference=localhost/airflow-runtime | while read -r ref; do
  podman rmi "$ref" > /dev/null 2>&1 || true
done

rm -rf /etc/airflow '${stage_dir}'
%{ if purge ~}
log "purging ${base_dir}"
rm -rf '${base_dir}'
%{ else ~}
log "kept ${base_dir} (purge_data_on_destroy = false)"
%{ endif ~}
log "done"
