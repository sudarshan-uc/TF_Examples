# Managed by Terraform (airflow-podman). Local edits are overwritten on the next apply.
# config-sha256: ${config_hash}
[Unit]
Description=Airflow ${component}
Wants=network-online.target%{ for a in after } ${a}%{ endfor }
After=network-online.target%{ for a in after } ${a}%{ endfor }
StartLimitIntervalSec=0

[Container]
ContainerName=${name}
Image=${image}
%{ if exec != "" ~}
Exec=${exec}
%{ endif ~}
Network=host
%{ for a in add_hosts ~}
AddHost=${a}
%{ endfor ~}
%{ for f in env_files ~}
EnvironmentFile=${f}
%{ endfor ~}
%{ for v in volumes ~}
Volume=${v}
%{ endfor ~}
%{ for s in secrets ~}
Secret=${s}
%{ endfor ~}
%{ if health_cmd != "" ~}
HealthCmd=${health_cmd}
HealthInterval=60s
HealthTimeout=45s
HealthStartPeriod=180s
HealthRetries=3
HealthOnFailure=kill
%{ endif ~}
Label=io.astronomer.managed-by=terraform
Label=io.astronomer.component=${component}

[Service]
%{ if oneshot ~}
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=30
TimeoutStartSec=1800
%{ else ~}
Restart=always
RestartSec=10
TimeoutStartSec=300
%{ endif ~}

[Install]
WantedBy=multi-user.target
