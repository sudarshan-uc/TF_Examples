#!/usr/bin/env bash
# Rendered by Terraform (airflow-podman), phase "${phase}". Runs as root over SSH
# and is deleted right after it runs: it carries secrets. Safe to run again.
set -euo pipefail
umask 077

PHASE='${phase}'
# Not every phase uses all of these.
# shellcheck disable=SC2034
BASE='${base_dir}'
# shellcheck disable=SC2034
STAGE='${stage_dir}'
# shellcheck disable=SC2034
IMAGE='${image}'
ETC=/etc/airflow
UNIT_DIR=/etc/containers/systemd
AUTHFILE="$ETC/registry-auth.json"
CHANGED=' '
RELOAD=0

log() { printf '[airflow-podman %s %s] %s\n' "$PHASE" "$(date -u +%H:%M:%S)" "$*"; }
die() { printf '[airflow-podman %s] ERROR: %s\n' "$PHASE" "$*" >&2; exit 1; }

# put_file PATH MODE OWNER BASE64: writes only when the content differs.
# Returns 0 when the file was written, 1 when it was already up to date.
put_file() {
  local path=$1 mode=$2 owner=$3 b64=$4 tmp
  tmp=$(mktemp "$path.XXXXXX")
  printf '%s' "$b64" | base64 -d > "$tmp"
  chmod "$mode" "$tmp"
  chown "$owner" "$tmp"
  if [ -f "$path" ] && cmp -s "$tmp" "$path"; then
    rm -f "$tmp"
    chmod "$mode" "$path"
    chown "$owner" "$path"
    return 1
  fi
  mv -f "$tmp" "$path"
  return 0
}

write_unit() {
  if put_file "$UNIT_DIR/$1.container" 0644 root:root "$2"; then
    CHANGED="$CHANGED$1 "
    RELOAD=1
    log "unit $1 updated"
  fi
}

remove_unit() {
  if [ -f "$UNIT_DIR/$1.container" ]; then
    log "removing $1 (no longer placed on this host)"
    systemctl stop "$1.service" 2>/dev/null || true
    rm -f "$UNIT_DIR/$1.container"
    systemctl reset-failed "$1.service" 2>/dev/null || true
    RELOAD=1
  fi
}

reload_units() {
  [ "$RELOAD" = 1 ] || return 0
  if ! QUADLET_UNIT_DIRS="$UNIT_DIR" "$QUADLET" -dryrun > "$ETC/quadlet-dryrun.out" 2>&1; then
    cat "$ETC/quadlet-dryrun.out" >&2
    die "quadlet rejected the unit files in $UNIT_DIR"
  fi
  systemctl daemon-reload
}

show_failure() {
  systemctl status "$1.service" --no-pager -l 2>&1 | tail -n 15 >&2 || true
  journalctl -u "$1.service" -n 60 --no-pager >&2 || true
}

# Restart a unit when its file changed or it isn't running. A oneshot unit
# (db migrate) blocks here until it has finished.
start_unit() {
  if [[ "$CHANGED" == *" $1 "* ]] || ! systemctl is-active --quiet "$1.service"; then
    log "starting $1"
    if ! systemctl restart "$1.service"; then
      show_failure "$1"
      die "$1 failed to start"
    fi
  else
    log "$1 unchanged and running"
  fi
}

# Wait until the container's own health check passes.
wait_healthy() {
  local name=$1 tries=$2
  for _ in $(seq 1 "$tries"); do
    if podman healthcheck run "$name" > /dev/null 2>&1; then
      log "$name healthy"
      return 0
    fi
    sleep 5
  done
  show_failure "$name"
  die "$name not healthy after $((tries * 5))s"
}

pull_image() {
  if podman image exists "$1"; then
    return 0
  fi
  log "pulling $1"
  # shellcheck disable=SC2086
  podman pull $AUTH_OPT "$1" > /dev/null
}

# ------------------------------------------------------------------ preflight

if ! command -v podman > /dev/null 2>&1; then
%{ if install_podman ~}
  log "installing podman"
  if command -v dnf > /dev/null 2>&1; then
    dnf install -y podman
  elif command -v apt-get > /dev/null 2>&1; then
    apt-get update -y && DEBIAN_FRONTEND=noninteractive apt-get install -y podman
  else
    die "podman is missing and neither dnf nor apt-get is available"
  fi
%{ else ~}
  die "podman is not installed. Install podman 4.6+ in the VM image, or set install_podman = true"
%{ endif ~}
fi

PODMAN_VERSION=$(podman version --format '{{.Client.Version}}' 2> /dev/null || podman --version | awk '{print $NF}')
if [ "$(printf '%s\n' 4.6.0 "$PODMAN_VERSION" | sort -V | head -n1)" != 4.6.0 ]; then
  die "podman $PODMAN_VERSION is too old: 4.6 or newer is required (quadlet HealthOnFailure)"
fi

QUADLET=''
for q in /usr/libexec/podman/quadlet /usr/lib/podman/quadlet; do
  if [ -x "$q" ]; then QUADLET=$q; break; fi
done
[ -n "$QUADLET" ] || die "quadlet not found (expected /usr/libexec/podman/quadlet or /usr/lib/podman/quadlet)"
command -v systemctl > /dev/null 2>&1 || die "systemd is required"

mkdir -p "$ETC" "$UNIT_DIR"
chmod 0700 "$ETC"
AUTH_OPT=''
if [ -f "$AUTHFILE" ]; then AUTH_OPT="--authfile $AUTHFILE"; fi

%{ if phase == "base" ~}
# ------------------------------------------------------------------ base: files, images, DAGs, Postgres/Redis

%{ if authfile_b64 != "" ~}
put_file "$AUTHFILE" 0600 root:root '${authfile_b64}' || true
AUTH_OPT="--authfile $AUTHFILE"
%{ else ~}
rm -f "$AUTHFILE"
AUTH_OPT=''
%{ endif ~}
%{ if netrc_b64 != "" ~}
put_file "$ETC/netrc" 0600 root:root '${netrc_b64}' || true
%{ else ~}
rm -f "$ETC/netrc"
%{ endif ~}
%{ for f in root_files ~}
put_file '${f.path}' ${f.mode} root:root '${f.b64}' || true
%{ endfor ~}

mkdir -p "$BASE"
chmod 0755 "$BASE"
%{ for img in pull_images ~}
pull_image '${img}'
%{ endfor ~}

%{ if airflow_host ~}
mkdir -p "$BASE/dags" "$BASE/logs" "$BASE/config"

%{ if build_mode ~}
if podman image exists "$IMAGE"; then
  log "image $IMAGE already built"
else
  [ -f "$STAGE/payload/Dockerfile" ] || die "no Dockerfile in $STAGE/payload; re-run apply with -replace on this host's terraform_data.base"
  log "building $IMAGE"
  NETRC_OPT=''
  if [ -f "$ETC/netrc" ]; then NETRC_OPT="--secret id=netrc,src=$ETC/netrc"; fi
  # shellcheck disable=SC2086
  # docker format keeps the Runtime image's ONBUILD SHELL (bash -o pipefail);
  # the default OCI format drops it and runs the steps with /bin/sh.
  podman build --format docker $AUTH_OPT $NETRC_OPT --pull=missing --tag "$IMAGE" "$STAGE/payload"
fi
%{ endif ~}

# The Chainguard image has no `id`; ask Python for the container user.
AF_UID=$(podman run --rm --network none --entrypoint python "$IMAGE" -c 'import os; print(os.getuid())' 2> /dev/null | tail -n1)
case "$AF_UID" in
  '' | *[!0-9]*) die "could not read the container user ID from $IMAGE" ;;
esac
echo "$AF_UID" > "$ETC/airflow-uid"

chown "$AF_UID:0" "$BASE/logs" "$BASE/config"
chmod 0750 "$BASE/logs" "$BASE/config"
put_file "$BASE/config/simple_auth_manager_passwords.json" 0600 "$AF_UID:0" '${passwords_b64}' || true

%{ if mount_dags ~}
WANT_DAGS='${dags_hash}'
if [ "$(cat "$ETC/dags.sha256" 2> /dev/null || true)" = "$WANT_DAGS" ]; then
  log "DAGs unchanged"
else
  SRC='${dags_src}'
  [ -d "$SRC" ] || mkdir -p "$SRC"
  log "syncing DAGs"
  # Copy first, then delete what was removed, so the folder never goes empty
  # while the dag-processor is parsing it.
  if command -v rsync > /dev/null 2>&1; then
    rsync -a --delete-delay --exclude '__pycache__' "$SRC/" "$BASE/dags/"
  else
    (umask 022 && cp -R "$SRC/." "$BASE/dags/")
    (cd "$BASE/dags" && find . -mindepth 1 -depth -print) | while IFS= read -r p; do
      if [ ! -e "$SRC/$p" ] && [ ! -L "$SRC/$p" ]; then rm -rf -- "$BASE/dags/$p"; fi
    done
  fi
  chown -R "$AF_UID:0" "$BASE/dags"
  chmod -R u=rwX,g=rX,o= "$BASE/dags"
  echo "$WANT_DAGS" > "$ETC/dags.sha256"
fi
%{ endif ~}
%{ endif ~}

%{ if contains(roles, "postgres") ~}
# The image's entrypoint drops to the postgres user, which must traverse this
# directory to reach PGDATA (a 0700 subdirectory it owns).
mkdir -p "$BASE/postgres"
chmod 0755 "$BASE/postgres"
%{ endif ~}
%{ if redis_conf_b64 != "" ~}
mkdir -p "$BASE/redis"
chmod 0755 "$BASE/redis"
WANT_REDIS=$(printf '%s' '${redis_conf_b64}' | sha256sum | cut -d' ' -f1)
if ! podman secret inspect airflow-redis-conf > /dev/null 2>&1 || [ "$(cat "$ETC/redis-conf.sha256" 2> /dev/null || true)" != "$WANT_REDIS" ]; then
  log "updating podman secret airflow-redis-conf"
  podman secret rm airflow-redis-conf > /dev/null 2>&1 || true
  printf '%s' '${redis_conf_b64}' | base64 -d | podman secret create airflow-redis-conf - > /dev/null
  echo "$WANT_REDIS" > "$ETC/redis-conf.sha256"
fi
%{ endif ~}
%{ endif ~}

%{ if phase == "migrate" ~}
# Fail fast with a clear message when the DB is unreachable or the credentials
# are wrong. Bypasses the image entrypoint, which would wait indefinitely.
log "checking the metadata database connection"
if ! timeout 300 podman run --rm --network host --env-file "$ETC/airflow.env" --entrypoint airflow "$IMAGE" db check --retry 12 --retry-delay 5; then
  die "cannot connect to the Airflow metadata database (sql_alchemy_conn). Check the host, port, credentials and firewall from this VM"
fi
%{ endif ~}

# ------------------------------------------------------------------ units

%{ for u in units ~}
write_unit '${u.name}' '${u.b64}'
%{ endfor ~}
%{ for n in prune ~}
remove_unit '${n}'
%{ endfor ~}
reload_units
%{ if phase == "base" && redis_conf_b64 == "" ~}
# Redis is not (or no longer) placed here: drop its config secret.
podman secret rm airflow-redis-conf > /dev/null 2>&1 || true
rm -f "$ETC/redis-conf.sha256"
%{ endif ~}

%{ for n in start ~}
start_unit '${n}'
%{ endfor ~}

%{ if phase == "base" ~}
# Postgres/Redis must answer before migrate runs (the Runtime entrypoint
# otherwise waits for the DB port with no time limit).
%{ for n in start ~}
wait_healthy '${n}' 36
%{ endfor ~}
%{ endif ~}

%{ if phase == "airflow" ~}
# ------------------------------------------------------------------ airflow: wait and verify

%{ if wait_api ~}
log "waiting for the API server health check"
API_OK=0
for _ in $(seq 1 60); do
  if podman healthcheck run airflow-api-server > /dev/null 2>&1; then API_OK=1; break; fi
  sleep 5
done
if [ "$API_OK" != 1 ]; then
  show_failure airflow-api-server
  die "API server not healthy after 5 minutes (port ${api_port})"
fi
log "API server healthy on port ${api_port}"
%{ endif ~}

# Catch containers that start, then crash on config or DB errors.
sleep 20
FAILED=''
%{ for n in start ~}
if ! systemctl is-active --quiet '${n}.service'; then show_failure '${n}'; FAILED="$FAILED ${n}"; fi
%{ endfor ~}
[ -z "$FAILED" ] || die "not running:$FAILED"

%{ if prune_images ~}
# Drop images from earlier builds; the running one is kept.
podman images --format '{{.Repository}}:{{.Tag}}' --filter reference=localhost/airflow-runtime | while read -r ref; do
  if [ "$ref" != "$IMAGE" ]; then podman rmi "$ref" > /dev/null 2>&1 || true; fi
done
%{ endif ~}
%{ endif ~}

podman ps --filter label=io.astronomer.managed-by=terraform --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}'
log "done"
