# One EC2 instance (or any Linux VM with podman 4.6+ and systemd), customer-provided
# Postgres, Astro project built on the VM. Copy to terraform.tfvars and edit.

hosts = {
  airflow1 = {
    address  = "10.20.30.40"
    host_key = "ssh-ed25519 AAAA...replace-with-the-VM-host-key"
  }
}

ssh = {
  user             = "ec2-user"
  private_key_path = "~/.ssh/airflow-poc.pem"
  # Optional jump host:
  # bastion_host = "bastion.example.com"
  # bastion_user = "ec2-user"
}

# Astro project: Dockerfile (FROM quay.io/astronomer/astro-runtime:3.4-1-chainguard),
# requirements.txt, packages.txt, dags/. In CI, point this at the checked-out repo.
project_dir = "../my-astro-project"

# Customer-provided metadata DB (Postgres 14-18). URL-encode special characters in the password.
# Pass it through the environment rather than this file:
#   export TF_VAR_sql_alchemy_conn='postgresql+psycopg2://airflow:...@db.example.internal:5432/airflow'

executor = "LocalExecutor"

users = {
  admin   = "admin"
  analyst = "viewer"
}

# Behind a load balancer:
# api_base_url = "https://airflow-poc.example.com"

# Internal registry instead of quay.io (also change FROM in the Dockerfile):
# registry_auth = {
#   "artifactory.example.com" = { username = "svc-airflow", password = "..." }
# }

airflow_env = {
  AIRFLOW__CORE__PARALLELISM = "32"
}
