# Three VMs, CeleryExecutor, customer-provided Postgres and Redis.
# All hosts must reach each other on the ports in `terraform output inbound_ports`.

hosts = {
  control = {
    address = "10.20.30.10"
    roles   = ["api-server", "scheduler", "dag-processor", "triggerer"]
  }
  worker1 = {
    address            = "10.20.30.21"
    roles              = ["worker"]
    worker_concurrency = 16
  }
  worker2 = {
    address            = "10.20.30.22"
    roles              = ["worker"]
    worker_queues      = ["default", "heavy"]
    worker_concurrency = 8
  }
}

ssh = {
  user             = "ec2-user"
  private_key_path = "~/.ssh/airflow-poc.pem"
}

project_dir = "../my-astro-project"
executor    = "CeleryExecutor"

# export TF_VAR_sql_alchemy_conn='postgresql+psycopg2://airflow:...@db.example.internal:5432/airflow'
# export TF_VAR_celery_broker_url='redis://:...@redis.example.internal:6379/0'
